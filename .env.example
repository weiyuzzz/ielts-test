# --- Database (required)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# --- Audio storage (optional, default ./storage/audio)
# AUDIO_STORAGE_DIR=/var/lib/bandnine/audio

# --- Question-bank admin (/admin). Strongly recommended in production.
# When set, import/activate calls require the x-admin-token header.
# ADMIN_TOKEN=

# --- Shared OpenAI-compatible credentials (OpenAI, DeepSeek, Qwen compatible-mode, Groq, vLLM...)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- ASR: openai | browser | none   (default: openai if a key exists, else browser)
# ASR_PROVIDER=openai
# ASR_MODEL=whisper-1
# ASR_BASE_URL=            # override per service, e.g. https://api.groq.com/openai/v1
# ASR_API_KEY=

# --- LLM (examiner follow-ups + language scoring): openai | anthropic | none
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=
# LLM_API_KEY=
# ANTHROPIC_API_KEY=

# --- Examiner voice (TTS): openai | azure | browser
# Default is "auto": use a configured service if one exists, else browser speechSynthesis.
# TTS_PROVIDER=openai
#
# Examiner voice profile (Phase 2). This sets the DEFAULT profile only —
# a per-user choice in Settings / Voice Lab overrides it, and every exam
# freezes the profile it started with.
# EXAMINER_PROFILE=azure-sonia   # azure-sonia | azure-ryan | openai-marin | kokoro-af-heart | browser-en-gb
#
# 1) OpenAI-compatible /audio/speech (OpenAI, Kokoro, vLLM-compatible TTS...)
# TTS_BASE_URL=            # e.g. http://localhost:8880/v1 for local Kokoro
# TTS_API_KEY=
# TTS_MODEL=gpt-4o-mini-tts   # or "kokoro"
# TTS_VOICE=alloy             # Kokoro: af_heart (A-grade), bf_emma (British, B-)
# TTS_FORMAT=mp3              # mp3 | wav | flac | aac | opus; wav/flac are lossless
# TTS_SPEED=0.95              # examiner pace; 1.0 is neutral
# TTS_PITCH=0                 # semitones, −2…+2; engines without pitch support ignore it
# TTS_PROSODY=1               # 1 = sentence pauses via SSML (compatible engines only)
# TTS_STREAM=1                # 1 = progressive sentence-by-sentence playback
# TTS_INSTRUCTIONS=           # overrides the per-speech-act steering for gpt-4o-*-tts
#
# 2) Azure Neural TTS (most natural, genuine British neural voices).
#    Reuses the same speech key/region as pronunciation assessment.
# TTS_PROVIDER=azure
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=eastasia
# AZURE_TTS_VOICE=en-GB-SoniaNeural   # or en-GB-RyanNeural
# AZURE_TTS_FORMAT=riff-48khz-16bit-mono-pcm
#
# 3) No key at all → browser speechSynthesis (least natural; cloud/neural voices preferred).
# TTS_PROVIDER=browser
#
# Server-side clip cache (repeated lines are served from memory)
# TTS_CACHE_ENTRIES=80
# TTS_CACHE_BYTES=33554432

# --- Pronunciation (audio-based): azure | none
# PRONUNCIATION_PROVIDER=azure
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=eastasia

# --- Timeouts (ms)
# ASR_TIMEOUT_MS=45000
# LLM_TIMEOUT_MS=60000
# LLM_FOLLOWUP_TIMEOUT_MS=8000
# TTS_TIMEOUT_MS=30000
# PRONUNCIATION_TIMEOUT_MS=30000
