# --- Database (required)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# --- Audio storage (optional, default ./storage/audio)
# AUDIO_STORAGE_DIR=/var/lib/bandnine/audio
# --- Learning-content sidecar (optional, default ./src/data/learning)
# Study material (sample answers, idea notes, key phrases, shadowing audio refs)
# is stored as one JSON file per season. Point this at a WRITABLE, PERSISTENT
# directory in production: the default lives inside the application source tree,
# so on a read-only image / serverless runtime imports fail, and on redeploy the
# content is lost. Writes are atomic and serialised per season in-process, but
# multiple instances are NOT kept consistent (use a shared volume or object
# storage if you scale out).
# LEARNING_CONTENT_DIR=/var/lib/bandnine/learning

# --- Question-bank admin (/admin). Strongly recommended in production.
# When set, import/activate calls require the x-admin-token header.
# ADMIN_TOKEN=

# --- Shared OpenAI-compatible credentials (OpenAI, DeepSeek, Qwen compatible-mode, Groq, vLLM...)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- ASR: openai | browser | none   (default: openai if a key exists, else browser)
# ASR_PROVIDER=openai
# ASR_MODEL=whisper-1
# ASR_BASE_URL=            # override per service, e.g. https://api.groq.com/openai/v1
# ASR_API_KEY=

# --- LLM (examiner follow-ups + language scoring): openai | anthropic | none
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=
# LLM_API_KEY=
# ANTHROPIC_API_KEY=

# --- Runtime AI config (optional)
# The /admin "AI 服务" panel writes provider settings here (default
# ./storage/ai-config.json, gitignored). Panel values take precedence over the
# environment variables above. The file is per-instance: for multi-instance
# deployments prefer env vars / a secrets manager.
# AI_CONFIG_PATH=/var/lib/bandnine/ai-config.json

# --- Examiner voice (TTS): openai | azure | browser
# Default is "auto": use a configured service if one exists, else browser speechSynthesis.
# TTS_PROVIDER=openai
#
# Examiner voice profile (Phase 2). This sets the DEFAULT profile only —
# a per-user choice in Settings / Voice Lab overrides it, and every exam
# freezes the profile it started with.
# EXAMINER_PROFILE=azure-sonia   # azure-sonia | azure-ryan | openai-marin | kokoro-af-heart | browser-en-gb
#
# 1) OpenAI-compatible /audio/speech (OpenAI, Kokoro, vLLM-compatible TTS...)
# TTS_BASE_URL=            # e.g. http://localhost:8880/v1 for local Kokoro
# TTS_API_KEY=
# TTS_MODEL=gpt-4o-mini-tts   # or "kokoro"
# TTS_VOICE=alloy             # Kokoro: af_heart (A-grade), bf_emma (British, B-)
# TTS_FORMAT=mp3              # mp3 | wav | flac | aac | opus; wav/flac are lossless
# TTS_SPEED=0.95              # examiner pace; 1.0 is neutral
# TTS_PITCH=0                 # semitones, −2…+2; engines without pitch support ignore it
# TTS_PROSODY=1               # 1 = sentence pauses via SSML (compatible engines only)
# TTS_STREAM=1                # 1 = progressive sentence-by-sentence playback
# ALLOW_LOCAL_AI_ENDPOINTS=1  # REQUIRED for self-hosted engines (Kokoro on localhost:8880) —
#                             # the outbound-URL guard refuses loopback/private hosts otherwise
# TTS_CONCURRENCY=1           # synthesis parallelism (auto: kokoro=1, remote/GPU=2, range 1-4)
# TTS_START_GATE_MS=120000    # exam-start preparation gate (5.2)
# TTS_INSTRUCTIONS=           # overrides the per-speech-act steering for gpt-4o-*-tts
#
# 2) Azure Neural TTS (most natural, genuine British neural voices).
#    Reuses the same speech key/region as pronunciation assessment.
# TTS_PROVIDER=azure
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=eastasia
# AZURE_TTS_VOICE=en-GB-SoniaNeural   # or en-GB-RyanNeural
# AZURE_TTS_FORMAT=riff-48khz-16bit-mono-pcm
#
# 3) No key at all → browser speechSynthesis (least natural; cloud/neural voices preferred).
# TTS_PROVIDER=browser
#
# Server-side clip cache (repeated lines are served from memory)
# TTS_CACHE_ENTRIES=80
# TTS_CACHE_BYTES=33554432
#
# Managed-service restart (Settings → System diagnostics). The app NEVER runs
# shell commands built from user input; the "Restart engine" button exists only
# when an OS supervisor is explicitly declared here, and the command is a fixed
# literal (see docs/tts-engine-deployment.md for NSSM / launchd setup).
# TTS_SERVICE_MANAGER=nssm            # nssm | launchd — permission gate for restart
# TTS_SERVICE_NAME=KokoroTTS          # nssm service name
# TTS_SERVICE_LABEL=com.ielts.kokoro-tts  # launchd label (macOS)

# --- Pronunciation (audio-based): azure | tencent-soe | none
# PRONUNCIATION_PROVIDER=azure
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=eastasia

# --- Tencent Cloud Smart Oral Evaluation (智聆口语评测) — 国内直连的发音评测
# PRONUNCIATION_PROVIDER=tencent-soe
# TENCENT_SECRET_ID=                 # https://console.cloud.tencent.com/cam/capi
# TENCENT_SECRET_KEY=
# TENCENT_SOE_REGION=ap-guangzhou    # credential-scope region
# TENCENT_SOE_SCORE_COEFF=3.0        # 1.0 lenient … 4.0 strict (adult default 3.0)

# --- Tencent Cloud Flash Recognition (录音文件识别极速版) — 国内直连的 ASR，词级时间戳
# ASR_PROVIDER=tencent-asr
# TENCENT_APP_ID=                    # 控制台「账号信息」页的 APPID（子账号与主账号相同）
# TENCENT_ASR_ENGINE=16k_en          # 16k_en（英文）/ 16k_zh 等

# --- Timeouts (ms)
# ASR_TIMEOUT_MS=45000
# LLM_TIMEOUT_MS=60000
# LLM_FOLLOWUP_TIMEOUT_MS=8000
# TTS_TIMEOUT_MS=30000
# PRONUNCIATION_TIMEOUT_MS=30000
